{
  "name": "agenttohuman",
  "version": "0.1.0",
  "description": "Agent-to-human notifications. CLI binary: a2h.",
  "type": "module",
  "bin": {
    "a2h": "dist/cli-entry.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli-entry.js",
    "test": "tsc && node --test dist/config.test.js dist/cli.test.js dist/methods/discord-webhook.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TyrellD1/agenttohuman.git"
  },
  "keywords": [
    "a2h",
    "agent",
    "cli",
    "discord",
    "webhook",
    "notifications"
  ],
  "author": "TyrellD1",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TyrellD1/agenttohuman/issues"
  },
  "homepage": "https://github.com/TyrellD1/agenttohuman#readme",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
